{
    "name": "kr0lik/phpstan-rules",
    "type": "library",
    "description": "Provides additional rules for phpstan/phpstan.",
    "require": {
        "php": "^8.0",
        "ergebnis/phpstan-rules": "^2.0",
        "larastan/larastan": "^2.0",
        "pepakriz/phpstan-exception-rules": "^0.12.0",
        "phpstan/phpstan": "^1.0",
        "phpstan/phpstan-phpunit": "^1.0",
        "phpstan/phpstan-strict-rules": "^1.0",
        "phpstan/phpstan-symfony": "^1.0",
        "shipmonk/phpstan-rules": "^3.0",
        "slam/phpstan-extensions": "^6.0",
        "soyhuce/phpstan-extension": "^1.0",
        "thecodingmachine/phpstan-strict-rules": "^1.0"
    },
    "require-dev": {
        "kr0lik/php-cs-fixer": "^2.0",
        "phpunit/phpunit": "^9.0"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "icanhazstring/composer-unused": true
        }
    },
    "autoload": {
        "psr-4": {
            "kr0lik\\PHPStanRules\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "kr0lik\\PHPStanRules\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/"
        ]
    }
}
